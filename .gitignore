/data/remember.json
/data/.storage.lock
/data/.json-*
!/public/uploads/.htaccess

/tests/__pycache__/
/data/.restore-*

# GitHub updater state and private code backups
/data/update-*.json
/data/update-work/
/data/update-backups/
