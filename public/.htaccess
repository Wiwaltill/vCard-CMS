RewriteEngine On

# Bestehende Dateien und Ordner nicht erneut umschreiben.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteCond %{THE_REQUEST} \s/+admin/([^\s?]+)\.php[\s?] [NC]
RewriteRule ^admin/(.+)\.php$ /admin/$1 [R=301,L]

RewriteRule ^install/?$ install.php [L,QSA]
RewriteRule ^$ index.php [L,QSA]

RewriteRule ^admin/?$ admin/index.php [L]
RewriteRule ^admin/(login|logout|settings|new|edit|delete)$ admin/$1.php [L,QSA]

RewriteRule ^([a-z0-9]{2,6})$ card.php?id=$1 [L,QSA]
RewriteRule ^([a-z0-9]{2,6})/vcard$ vcard.php?id=$1 [L,QSA]

# Fallback für unbekannte URLs.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ index.php [L,QSA]
