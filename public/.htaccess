RewriteEngine On

# Bestehende Dateien und Ordner nicht erneut umschreiben.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteCond %{THE_REQUEST} \s/+admin/([^\s?]+)\.php[\s?] [NC]
RewriteRule ^admin/(.+)\.php$ /admin/$1 [R=301,L]

RewriteRule ^install/?$ install.php [L,QSA]
RewriteRule ^$ index.php [L,QSA]

RewriteRule ^admin/?$ admin/index.php [L]
RewriteRule ^admin/(login|logout|settings|new|edit|delete|datatypes|import_export|backup|api)$ admin/$1.php [L,QSA]
RewriteRule ^api/contacts/?$ api.php [L,QSA]
RewriteRule ^api/contacts/([a-z0-9]{2,20})/?$ api.php?id=$1 [L,QSA]
RewriteRule ^manifest.webmanifest$ manifest.php [L,QSA]
RewriteRule ^sw.js$ sw.php [L,QSA]
RewriteRule ^qr/([a-z0-9]{2,20})/(png|svg)$ qr.php?id=$1&format=$2 [L,QSA]

RewriteRule ^([a-z0-9]{2,6})$ card.php?id=$1 [L,QSA]
RewriteRule ^([a-z0-9]{2,6})/vcard$ vcard.php?id=$1 [L,QSA]

# Fallback für unbekannte URLs.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ index.php [L,QSA]
